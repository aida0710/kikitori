<Window x:Class="Kikitori.Windows.Ui.DictationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kikitori"
        Width="560"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        FontFamily="Segoe UI, Yu Gothic UI">
    <!-- 色は Mado のデザインシステムの上部バーと同じ（暗い地 #151515、文字 #EFEFEF、印 #00B9B1） -->
    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#F2151515" />
        <SolidColorBrush x:Key="Border" Color="#333333" />
        <SolidColorBrush x:Key="Text" Color="#EFEFEF" />
        <SolidColorBrush x:Key="Muted" Color="#9AA0A6" />
        <SolidColorBrush x:Key="Indicator" Color="#00B9B1" />
        <SolidColorBrush x:Key="Hover" Color="#333333" />
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="8" Width="32" Height="32">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="12" CornerRadius="14" Background="{StaticResource Surface}"
            BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="12,10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.4" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- マイクの印。話している音の大きさで外側の輪が広がる。押すと止める -->
            <Button x:Name="MicrophoneButton" Grid.Column="0" Focusable="False" Cursor="Hand"
                    Click="MicrophoneButton_Click" VerticalAlignment="Center">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="44" Height="44">
                            <Ellipse x:Name="LevelRing" Fill="{StaticResource Indicator}" Opacity="0.25"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="LevelScale" ScaleX="0.7" ScaleY="0.7" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="Disc" Width="32" Height="32" Fill="{StaticResource Indicator}" />
                            <TextBlock Text="&#xE720;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                       Foreground="#151515" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" FontSize="12" />
                <TextBlock x:Name="TranscriptText" Foreground="{StaticResource Text}" FontSize="15"
                           TextWrapping="Wrap" MaxHeight="64" Margin="0,2,0,0" />
            </StackPanel>

            <Button x:Name="CancelButton" Grid.Column="2" Style="{StaticResource IconButton}"
                    Click="CancelButton_Click" VerticalAlignment="Top">
                <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
            </Button>
        </Grid>
    </Border>
</Window>
