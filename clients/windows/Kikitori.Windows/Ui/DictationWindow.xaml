<Window x:Class="Kikitori.Windows.Ui.DictationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kikitori"
        Width="580"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        FontFamily="Segoe UI, Yu Gothic UI" FontSize="14">
    <!-- 色は管理画面と同じ（黒の面 #141414、線 #2A2A2A、文字 #EDEDED、マイクの印は紫の傾き） -->
    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#F7141414" />
        <SolidColorBrush x:Key="Border" Color="#2A2A2A" />
        <SolidColorBrush x:Key="Text" Color="#EDEDED" />
        <SolidColorBrush x:Key="Muted" Color="#8F8F8F" />
        <SolidColorBrush x:Key="Idle" Color="#3A3A3A" />
        <LinearGradientBrush x:Key="Indicator" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#8B5CF6" Offset="0" />
            <GradientStop Color="#6366F1" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="LevelRingFill" Color="#8B5CF6" />
        <SolidColorBrush x:Key="Hover" Color="#1A1A1A" />
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="8" Width="32" Height="32">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="28" CornerRadius="12" Background="{StaticResource Surface}"
            BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="14,12">
        <Border.Effect>
            <!-- 影が窓の外へはみ出して四角く切れないよう、Margin は BlurRadius と ShadowDepth の和より大きくする -->
            <DropShadowEffect BlurRadius="20" ShadowDepth="6" Direction="270" Opacity="0.6" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- マイクの印。話している音の大きさで外側の輪が広がる。押すと止める -->
            <Button x:Name="MicrophoneButton" Grid.Column="0" Focusable="False" Cursor="Hand"
                    Click="MicrophoneButton_Click" VerticalAlignment="Center">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="48" Height="48">
                            <Ellipse x:Name="LevelRing" Fill="{StaticResource LevelRingFill}" Opacity="0.25"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="LevelScale" ScaleX="0.7" ScaleY="0.7" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="Disc" Width="36" Height="36" Fill="{StaticResource Indicator}" />
                            <TextBlock Text="&#xE720;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                       Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" FontSize="12" />
                <TextBlock x:Name="TranscriptText" Foreground="{StaticResource Text}" FontSize="14"
                           TextWrapping="Wrap" MaxHeight="64" Margin="0,2,0,0" />
            </StackPanel>

            <Button x:Name="CancelButton" Grid.Column="2" Style="{StaticResource IconButton}"
                    Click="CancelButton_Click" VerticalAlignment="Center" Opacity="0.7">
                <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
            </Button>
        </Grid>
    </Border>
</Window>
